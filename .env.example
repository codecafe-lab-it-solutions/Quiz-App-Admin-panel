# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/quiz_attendance"

# JWT secrets - use long random strings in production
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# Token lifetimes
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Seed super-admin credentials (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Password used for all other demo accounts seed.ts creates (extra admin,
# demo faculty, demo students). Optional - defaults to "DemoPass123!".
SEED_DEMO_PASSWORD="DemoPass123!"


# Public base URL of the app (used for links in generated reports, if needed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# RGIPT ERP mail-OTP API (used server-side only, by /api/auth/forgot-password,
# to email the forgot-password OTP). The key must never be exposed client-side.
ERP_MAIL_OTP_API_URL="http://rgipterp.com/erp/appapk/api-send-mail-otp.php"
ERP_MAIL_OTP_API_KEY="replace-with-the-real-erp-api-key"

# ERP single sign-on ("Login with Quiz Panel" button in the CRM).
# 64 hex chars (32 bytes) shared secret, e.g. `openssl rand -hex 32` - must match the ERP side.
ERP_SSO_SECRET="replace-with-64-hex-characters"

# Where question-image uploads are stored (keep OUTSIDE the release dir so redeploys do not wipe them)
UPLOAD_DIR="/home/sites/quiz-app/shared/uploads"

# Set to true to let faculty start/stop quizzes from the web panel again (default: faculty app only)
# ALLOW_WEB_QUIZ_CONTROL="true"
