generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  super_admin
  admin
}

enum PersonStatus {
  active
  inactive
}

enum QuizStatus {
  draft
  scheduled
  live
  completed
}

enum QuestionType {
  mcq
  formula
  subjective
}

enum AllotmentStatus {
  allotted
  attempted
  absent
}

enum AttemptStatus {
  in_progress
  submitted
  auto_submitted
}

enum AttendanceStatus {
  present
  absent
}

enum ResultStatus {
  pending
  declared
  published
}

// ---------------------------------------------------------------------------
// Identity / accounts
// ---------------------------------------------------------------------------

model Admin {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           AdminRole @default(admin)
  refreshTokenHash String? @map("refresh_token_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

model Building {
  id            Int      @id @default(autoincrement())
  name          String
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  radiusMeters  Int      @map("radius_meters")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  quizzes Quiz[]

  @@map("buildings")
}

// ---------------------------------------------------------------------------
// Legacy university database — read-only from this app's perspective.
// Faculty/Student master data and course mapping live here, not in this
// app's own tables. Never write to these models from application code.
// ---------------------------------------------------------------------------

model IsrLoginTbl {
  userRoll     String  @id @map("user_roll")
  // Confirmed nullable on the real table (601 of 3668 real rows have a null
  // password - accounts that apparently never set one) - this schema wrongly
  // carried these over as required before the real export was available to
  // check against, same mistake as isr_sub_available_tbl.sem (see there).
  userEmail    String? @map("user_email")
  userPassword String? @map("user_password")
  userType     String  @map("user_type") // 'FAC' | 'STU'
  // 1-Active, 2-Inactive (isr_login_tbl.status per confirmed legacy column list).
  status       Int     @default(1)

  // Remaining columns, confirmed against the real isr_login_tbl export, added
  // for full structural parity with the legacy table — so this app's own copy
  // has the same columns whether DATABASE_URL points at a local placeholder
  // or the real production legacy database.
  userPkId       Int?      @map("user_pk_id") // real auto-increment PK; app looks rows up by user_roll everywhere, this is informational only
  userMobile     String?   @map("user_mobile")
  refPassword    String?   @map("ref_password")
  centreLocation String?   @map("centre_location")
  programName    String?   @map("program_name")
  batch          String?
  branch         String? // Department Id of DUGC/DPGC
  userPermission String?   @map("user_permission")
  healthId       String?   @map("health_id")
  loginFlag      String?   @map("login_flag") @default("Y")
  timestamp      DateTime? @default(now())

  @@map("isr_login_tbl")
}

model IsrFacultyTbl {
  roll     String  @id
  name     String
  // Confirmed columns from the legacy schema, added for admin-panel profile
  // display only — never written to by this app except via updateFaculty()'s
  // existing name/email/password fields.
  dept     String?
  empCode  String? @map("emp_code")
  facStatus String? @map("fac_status") // R-Regular, V-Visiting, P-PFD, T-Temporary
  address  String? @db.Text

  // Remaining columns for full structural parity with the real isr_faculty_tbl.
  sr                   Int?      // real auto-increment PK; app looks up by roll everywhere
  dob                  DateTime? @db.Date
  password             String?
  email                String? // this table's own email column — distinct from isr_login_tbl.user_email
  newPassword          String?   @map("new_password")
  requestStatus        Int?      @map("request_status") // 1-Confirm, 2-Pending
  role                 String?
  feedbackView         String?   @map("feedback_view") @default("N")
  invigilatorStatus    Int?      @map("invigilator_status") @default(10)
  unavailableDatesinvi String?   @map("unavailable_datesinvi") @db.Text
  dateOfJoining        DateTime? @map("date_of_joining") @db.Date
  dateOfExit           DateTime? @map("date_of_exit") @db.Date
  payLevel             Int?      @map("pay_level") @default(0)
  payLevelId           Int?      @map("pay_level_id") @db.UnsignedInt
  hometownCity         String?   @map("hometown_city")
  hometownState        String?   @map("hometown_state")

  @@map("isr_faculty_tbl")
}

model IsrStuDataTbl {
  stuRoll String  @id @map("stu_roll")
  stuName String  @map("stu_name")
  mobile  String?

  // Remaining columns for full structural parity with the real isr_stu_data_tbl
  // — a ~60-column personal/family/hostel profile. Kept read-only; none of
  // these are surfaced on admin list views by default (several are sensitive
  // — Aadhaar, bank details, parent contact info). Pull individual fields
  // into a detail view deliberately, on request.
  dataSr                 Int?      @map("data_sr") // real auto-increment PK; app looks up by stu_roll everywhere
  uniqueCode             String?   @map("unique_code")
  stuSr                  Int?      @map("stu_sr")
  email                  String?
  joiningYear            Int?      @map("joining_year")
  centreLocation         String?   @map("centre_location")
  localAddress           String?   @map("local_address")
  homeAddress            String?   @map("home_address")
  homePhone              String?   @map("home_phone")
  contactPerson          String?   @map("contact_person")
  bloodGroup             String?   @map("blood_group")
  stuHindiname           String?   @map("stu_hindiname")
  stuGender              String?   @map("stu_gender")
  nationality            String?
  personalContactnumber  String?   @map("personal_contactnumber")
  dateBirth              String?   @map("date_birth")
  aadhaarCard            String?   @map("aadhaar_card")
  jacRegistrationNumber  String?   @map("jac_registration_number")
  channelAdmission       String?   @map("channel_admission")
  scoreCard              String?   @map("score_card")
  awardLetters           String?   @map("award_letters")
  category               String?
  pd                     String?
  km                     String?
  religion               String?
  lastSchoolname         String?   @map("last_schoolname") @db.Text
  schoolCity             String?   @map("school_city")
  schoolPincode          String?   @map("school_pincode")
  schoolState            String?   @map("school_state")
  schoolBoard            String?   @map("school_board")
  percentageinTwelve     String?   @map("percentagein_twelve")
  houseNumber            String?   @map("house_number")
  homeLandmark           String?   @map("home_landmark")
  homeArea               String?   @map("home_area")
  homeCity               String?   @map("home_city")
  homePincode            String?   @map("home_pincode")
  homeState              String?   @map("home_state")
  homeCountry            String?   @map("home_country")
  fatherName             String?   @map("father_name")
  fathernameHindi        String?   @map("fathername_hindi")
  fatherOccupation       String?   @map("father_occupation")
  fatherCompanyname      String?   @map("father_companyname")
  fatherDesignation      String?   @map("father_designation")
  fatherContactnumber    String?   @map("father_contactnumber")
  fatherEmailid          String?   @map("father_emailid")
  motherName             String?   @map("mother_name")
  motherOccupation       String?   @map("mother_occupation")
  motherCompanyname      String?   @map("mother_companyname")
  motherDesignation      String?   @map("mother_designation")
  motherContactnumber    String?   @map("mother_contactnumber")
  motherEmailid          String?   @map("mother_emailid")
  annualFamilyincome     String?   @map("annual_familyincome")
  emergencyPhonenumber   String?   @map("emergency_phonenumber")
  // Real column is NOT NULL with no default - kept optional here so this
  // app's create/update flows (which don't currently collect it) don't break;
  // supply a value before inserting against the real legacy table, or the
  // INSERT will be rejected there.
  emergencyName          String?   @map("emergency_name")
  bankName               String?   @map("bank_name")
  bankIfsc               String?   @map("bank_ifsc")
  bankAccountnumber      String?   @map("bank_accountnumber")
  lastUpdate             DateTime? @map("last_update")
  permanentAddress       String?   @map("permanent_address") @db.Text
  correspondenceAddress  String?   @map("correspondence_address") @db.Text
  hostelAddress          String?   @map("hostel_address") @db.Text
  hostelId               Int?      @map("hostel_id")
  roomNumber             String?   @map("room_number")
  bedCode                String?   @map("bed_code")
  hostelAssignDate       DateTime? @map("hostel_assign_date") @db.Date
  hostelValidityDate     DateTime? @map("hostel_validity_date") @db.Date

  @@map("isr_stu_data_tbl")
}

model IsrStuMainTbl {
  roll         String  @id
  major        String
  name         String
  batch        String
  // Real column is INT, not VARCHAR (isr_stu_main_tbl.sem_now) — kept as a
  // number to match the legacy type exactly; every app-facing surface
  // (forms, API types) still treats it as a string and converts at this
  // boundary, see getStudentByRoll/createStudent/updateStudent.
  semNow       Int     @map("sem_now")
  // Confirmed academic-status columns, surfaced read-only in admin/student views.
  regStatus    String? @map("reg_status")
  attnOk       String? @map("attn_ok")
  stuStatus    String? @map("stu_status")

  // Remaining columns for full structural parity with the real isr_stu_main_tbl.
  sr            Int?      // real auto-increment PK; app looks up by roll everywhere
  dob           String?
  password      String?
  phdCategory   String?   @map("phd_category")
  feeOk         String?   @map("fee_OK") @default("Y")
  cgpaOk        String?   @map("cgpa_OK") @default("Y")
  hostelStatus  String    @map("hostel_status") @default("N")
  lateUpto      Int?      @map("late_upto") @default(0)
  presentStatus String?   @map("present_status") @default("N")
  presentRemark String?   @map("present_remark") @db.Text
  newPassword   String?   @map("new_password")
  requestStatus Int?      @map("request_status")

  // App-added, NOT part of the real university dump - the source of truth
  // for section membership: a comma-joined list of every section name this
  // student belongs to (e.g. "PE_5,PE_T"). Read by getStudentsForRealSections
  // (section-sync.ts) for every faculty roster/allotment; written by
  // addSectionToStudents / fillEmptyStudentSection when students are added to
  // a section, and backfilled with scripts/backfill-student-sections.ts.
  // importRealLegacyData() truncates this table from the raw dump (which has
  // no such column), so re-run the backfill after any legacy re-import.
  section String? @db.Text

  @@map("isr_stu_main_tbl")
}

// PK confirmed as `avai_sr` from the real isr_sub_available_tbl export — the
// Prisma field is still called `id` (existing code already reads/writes it
// as such), @map just points it at the real column name.
model IsrSubAvailableTbl {
  id      Int     @id @default(autoincrement()) @map("avai_sr")
  // Confirmed nullable on the real table (`DEFAULT NULL`) - this schema
  // wrongly carried these over as required before the real export was
  // available to check against; real rows do have a null fac_roll.
  // Confirmed `int` on the real imported table (not varchar, as this schema
  // wrongly assumed before the real dump was available to check against) -
  // Prisma throws P2032 on every read of this column otherwise.
  sem     Int?
  subList String? @map("sub_list") @default("c1") // semester-cycle code, e.g. "C2" — admin-configurable "current" value
  subCode String? @map("sub_code")
  facRoll String? @map("fac_roll")
  branch  String?

  // Remaining columns for full structural parity with the real table.
  b1Sem   Int?    @map("b1_sem")
  semList String? @map("sem_list")
  slot    String?
  facOrder Int    @map("fac_order") @default(1)

  // App-added, NOT part of the real university dump - the single
  // Major_Semester section this specific mapping row resolves to (branch
  // normalized to the real major - see resolveMajorFromBranch - combined
  // with sem). Set once at creation (createFacultyCourseMapping /
  // ensureFacultyCourseSectionLinks) since each row's own branch+sem never
  // changes after that; rewritten after every legacy re-import, same reason
  // as IsrStuMainTbl.section.
  section String?

  @@map("isr_sub_available_tbl")
}

// Full curriculum/course catalog — read-only. Resolves a bare sub_code (from
// isr_sub_available_tbl / isr_reg_<batch>_tbl) into a human-readable title,
// credits and branch for course-list screens (§4.6 of the integration spec).
// PK confirmed as `sr` from the real isr_curriculum_tbl export — the Prisma
// field is still called `id` (existing code already reads it as such), @map
// just points it at the real column name.
model IsrCurriculumTbl {
  id         Int     @id @default(autoincrement()) @map("sr")
  subList    String  @map("sub_list")
  bsmsBranch String  @map("bsms_branch")
  bsmsCode   String  @map("bsms_code") // course code, joins to sub_code elsewhere
  title      String  @db.Text
  l          Int     @default(0)
  t          Int     @default(0)
  p          Int     @default(0)
  bsmsCredit Int     @default(0) @map("bsms_credit")
  sem        String?

  // Remaining columns for full structural parity with the real table.
  sp        String?
  deptCore  String? @map("dept_core")
  deptElec  String? @map("dept_elec")
  elecNum   String? @map("elec_num")
  openElec  String? @map("open_elec")
  deptMinor String? @map("dept_minor")

  @@index([bsmsCode])
  @@map("isr_curriculum_tbl")
}

// ---------------------------------------------------------------------------
// App-owned configuration for the legacy integration
// ---------------------------------------------------------------------------

model SemesterConfig {
  id              Int      @id @default(autoincrement())
  currentSubList  String   @map("current_sub_list")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("semester_config")
}

// Allow-list of batch -> physical isr_reg_<batch>_tbl table names, so
// dynamic-table queries never build a table name from unvalidated input.
model BatchTableRegistry {
  id        Int      @id @default(autoincrement())
  batchName String   @unique @map("batch_name")
  tableName String   @map("table_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("batch_table_registry")
}

// Forgot-password OTPs for isr_login_tbl accounts (student or faculty). The
// OTP itself is bcrypt-hashed, never stored plain - same reasoning as
// refresh-token storage elsewhere in this app. `attempts` caps brute-forcing
// a 5-digit code within its expiry window (see MAX_OTP_ATTEMPTS in the
// reset-password route).
model PasswordResetOtp {
  id         Int       @id @default(autoincrement())
  userRoll   String    @map("user_roll")
  userType   String    @map("user_type") // 'FAC' | 'STU'
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userRoll])
  @@map("password_reset_otps")
}

enum AccountDeletionRequestStatus {
  pending
  completed
  rejected
}

// Public "Delete Account" requests submitted from the login page (a public
// web page for this is required for Play Store compliance). Accounts here
// live in the external ISR/legacy system (see IsrLoginTbl), so this app
// can't delete them itself - a request just queues here for an admin to
// action manually in the legacy system, then mark resolved.
model AccountDeletionRequest {
  id                Int                           @id @default(autoincrement())
  identifier        String                        @map("identifier")
  status            AccountDeletionRequestStatus  @default(pending)
  reviewedByAdminId Int?                           @map("reviewed_by_admin_id")
  reviewedAt        DateTime?                      @map("reviewed_at")
  createdAt         DateTime                       @default(now()) @map("created_at")

  @@index([status])
  @@map("account_deletion_requests")
}

// ---------------------------------------------------------------------------
// Quiz domain
// ---------------------------------------------------------------------------

model Quiz {
  id                Int        @id @default(autoincrement())
  title             String
  // Legacy isr_curriculum_tbl.bsms_code / isr_sub_available_tbl.sub_code —
  // not a Prisma FK. courseName is a snapshot of the title at creation time
  // (isr_curriculum_tbl is sparsely populated, so re-resolving live on every
  // read can go blank for a code that resolved fine when the quiz was made).
  courseCode        String     @map("course_code")
  courseName        String     @map("course_name")
  // Comma-joined legacy Major_Semester section names (isr_sub_available_tbl.section)
  // this quiz was offered to, e.g. "PE_3,PE_5" — not a join table, since which
  // sections exist is always resolved live from the legacy table, never stored.
  sectionNames      String     @db.Text @map("section_names")
  facultyRoll       String     @map("faculty_roll") // legacy isr_faculty_tbl.roll — not a Prisma FK
  buildingId        Int        @map("building_id")
  startTime         DateTime   @map("start_time")
  endTime           DateTime   @map("end_time")
  durationMinutes   Int        @map("duration_minutes")
  totalMarks        Float      @map("total_marks")
  randomize         Boolean    @default(true)
  negativeMarking   Boolean    @default(false) @map("negative_marking")
  allowSkipSwitch   Boolean    @default(true) @map("allow_skip_switch")
  requireLocation   Boolean    @default(true) @map("require_location")
  status            QuizStatus @default(draft)
  actualStartTime   DateTime?  @map("actual_start_time")
  actualStopTime    DateTime?  @map("actual_stop_time")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id])

  questions   Question[]
  allotments  QuizAllotment[]
  attempts    QuizAttempt[]
  attendance  Attendance[]
  results     Result[]

  @@index([courseCode])
  @@index([facultyRoll])
  @@index([buildingId])
  @@index([status])
  @@map("quizzes")
}

model Question {
  id              Int          @id @default(autoincrement())
  quizId          Int          @map("quiz_id")
  questionText    String       @db.Text @map("question_text")
  questionType    QuestionType @map("question_type")
  marks           Float
  negativeMarks   Float        @default(0) @map("negative_marks")
  // Subjective-only, always optional even when questionType = subjective -
  // a manual-grading guide the faculty may leave blank. Never sent to students.
  referenceAnswer String?      @db.Text @map("reference_answer")
  orderIndex      Int          @map("order_index")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  quiz    Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  formula QuestionFormula?
  answers StudentAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  optionText String  @db.Text @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model QuestionFormula {
  id            Int   @id @default(autoincrement())
  questionId    Int   @unique @map("question_id")
  correctValue  Float @map("correct_value")
  tolerance     Float

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_formula")
}

model QuizAllotment {
  id          Int             @id @default(autoincrement())
  quizId      Int             @map("quiz_id")
  studentRoll String          @map("student_roll") // legacy isr_stu_data_tbl.stu_roll — not a Prisma FK
  status      AllotmentStatus @default(allotted)
  // Set when a faculty/admin flags this student's live attempt as a proxy
  // (someone else appears to be taking it). A proxy always counts as absent
  // (status flips to "absent"); un-flagging restores their real attendance.
  isProxy     Boolean         @default(false) @map("is_proxy")
  // Set when a faculty/admin exempts this student from the quiz's GPS/
  // location requirement. When true, start-attempt and geofence-check skip
  // the geofence check for this student regardless of Quiz.requireLocation.
  bypassLocation Boolean      @default(false) @map("bypass_location")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentRoll])
  @@index([studentRoll])
  @@index([status])
  @@map("quiz_allotments")
}

model QuizAttempt {
  id              Int           @id @default(autoincrement())
  quizId          Int           @map("quiz_id")
  studentRoll     String        @map("student_roll") // legacy isr_stu_data_tbl.stu_roll — not a Prisma FK
  startTime       DateTime      @default(now()) @map("start_time")
  endTime         DateTime?     @map("end_time")
  status          AttemptStatus @default(in_progress)
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  autoSubmitted   Boolean       @default(false) @map("auto_submitted")
  autoSubmitReason String?      @map("auto_submit_reason")
  questionOrder   String?       @db.Text @map("question_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers          StudentAnswer[]
  geofenceLogs     GeofenceLog[]

  @@unique([quizId, studentRoll])
  @@index([studentRoll])
  @@index([status])
  @@map("quiz_attempts")
}

model StudentAnswer {
  id               Int      @id @default(autoincrement())
  attemptId        Int      @map("attempt_id")
  questionId       Int      @map("question_id")
  selectedOptionId Int?     @map("selected_option_id")
  answerValue      Float?   @map("answer_value")
  // Subjective-only: student's free-text response, and whether a faculty
  // member has manually scored it yet (marksObtained stays 0 until then).
  writtenAnswer    String?  @db.Text @map("written_answer")
  manuallyGraded   Boolean  @default(false) @map("manually_graded")
  isCorrect        Boolean? @map("is_correct")
  marksObtained    Float    @default(0) @map("marks_obtained")
  orderIndex       Int      @map("order_index")
  isSkipped        Boolean  @default(false) @map("is_skipped")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  attempt        QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("student_answers")
}

model Attendance {
  id          Int               @id @default(autoincrement())
  studentRoll String            @map("student_roll") // legacy isr_stu_data_tbl.stu_roll — not a Prisma FK
  courseCode  String            @map("course_code") // legacy isr_curriculum_tbl.bsms_code — not a Prisma FK
  courseName  String            @map("course_name")
  quizId      Int               @map("quiz_id")
  date        DateTime          @db.Date
  status      AttendanceStatus
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentRoll, quizId])
  @@index([courseCode])
  @@index([studentRoll])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model Result {
  id            Int          @id @default(autoincrement())
  quizId        Int          @map("quiz_id")
  studentRoll   String       @map("student_roll") // legacy isr_stu_data_tbl.stu_roll — not a Prisma FK
  marksObtained Float        @default(0) @map("marks_obtained")
  percentage    Float        @default(0)
  status        ResultStatus @default(pending)
  declaredAt    DateTime?    @map("declared_at")
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentRoll])
  @@index([studentRoll])
  @@index([status])
  @@map("results")
}

model GeofenceLog {
  id              Int      @id @default(autoincrement())
  attemptId       Int?     @map("attempt_id")
  quizId          Int      @map("quiz_id")
  studentRoll     String   @map("student_roll") // legacy isr_stu_data_tbl.stu_roll — not a Prisma FK
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  distanceMeters  Float    @map("distance_meters")
  isWithinRange   Boolean  @map("is_within_range")
  checkedAt       DateTime @default(now()) @map("checked_at")

  attempt QuizAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([quizId])
  @@index([studentRoll])
  @@map("geofence_logs")
}
